# Public endpoint only. Never place provider keys in a VITE_ variable.
# Optional for local development only. Production uses same-origin functions automatically.
VITE_WEATHER_FUNCTIONS_BASE=http://localhost:8888/.netlify/functions

# Configure these as private environment variables in the hosting dashboard.
WEATHERAPI_KEY=
VISUALCROSSING_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
